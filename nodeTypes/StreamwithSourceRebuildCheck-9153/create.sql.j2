{# == Node Type Name           : Stream with Source Rebuild Check == #}
{# == Node Type Description    : This node creates and deploys a stream on top of a table, view or external table.
                                 Every redeployment checks the stream and recreates it if its source object was rebuilt
                                 (CREATE OR REPLACE / DROP+CREATE) or the stream is stale.
== #}

{% if desiredState %}

    {# Source Object Location and Name #}
    {% set sourceStorageLocation = desiredState.sources[0].dependencies[0].node.location.name %}
    {% set sourceDatabaseName = desiredState.storageLocations | selectattr('name', 'equalto', sourceStorageLocation) | map(attribute='database') | first %}
    {% set sourceSchemaName = desiredState.storageLocations | selectattr('name', 'equalto', sourceStorageLocation) | map(attribute='schema') | first %}
    {% set sourceTableName = desiredState.sources[0].dependencies[0].node.name %}
    {% set fullyQualifiedSourceTableName = '"' + sourceDatabaseName + '"."' + sourceSchemaName + '"."' + sourceTableName + '"' %}
    {% set refLink = "{{ ref('" + sourceStorageLocation + "', '" + sourceTableName + "') }}" %}

    {# Target Stream Location and Name #}
    {% set streamTargetLocationName = desiredState.node.location.name %}
    {% set streamTargetDatabaseName = desiredState.storageLocations | selectattr('name', 'equalto', streamTargetLocationName) | map(attribute='database') | first %}
    {% set streamTargetSchemaName = desiredState.storageLocations | selectattr('name', 'equalto', streamTargetLocationName) | map(attribute='schema') | first %}
    {% set streamName = desiredState.node.name %}


    {# Stream Type #}
    {% if desiredState.config.sourceType == 'Table' %} 
        {% set streamType = 'TABLE' %}
        {% set streamSourceObjectName = fullyQualifiedSourceTableName %}
    {% elif desiredState.config.sourceType == 'External Table' %} 
        {% set streamType = 'EXTERNAL TABLE' %}
        {% set streamSourceObjectName = fullyQualifiedSourceTableName %}
    {% elif desiredState.config.sourceType == 'External Iceberg Table' %} 
        {% set streamType = 'TABLE' %}
        {% set streamSourceObjectName = fullyQualifiedSourceTableName %}
    {% elif desiredState.config.sourceType == 'Directory Table' %} 
        {% set streamType = 'STAGE' %}
        {% set streamSourceObjectName = desiredState.config.stageName %}
    {% elif desiredState.config.sourceType == 'Dynamic Table' %} 
        {% set streamType = 'DYNAMIC TABLE' %}
        {% set streamSourceObjectName = fullyQualifiedSourceTableName %}
    {% else %} 
        {% set streamType = 'VIEW' %}
        {% set streamSourceObjectName = fullyQualifiedSourceTableName %}
    {% endif %}

    {# Stream Append Behavior #}
    {% if (streamType == 'TABLE' and desiredState.config.sourceType != 'External Iceberg Table') or streamType == 'VIEW' %} 
        {% if desiredState.config.appendOnly == true %} 
            {% set streamAppendMode = 'APPEND_ONLY = TRUE' %}
        {% else %} 
            {% set streamAppendMode = 'APPEND_ONLY = FALSE' %}
        {% endif %}
    {% else %}
        {% set streamAppendMode = '' %}
    {% endif %}

    {# Stream Initial Row Behavior #}
    {% if (streamType == 'TABLE' and desiredState.config.sourceType != 'External Iceberg Table') or streamType == 'VIEW' or streamType == 'DYNAMIC TABLE' %} 
        {% if desiredState.config.initialRows == true %} 
            {% set streamInitialRowsMode = 'SHOW_INITIAL_ROWS = TRUE' %}
        {% else %} 
            {% set streamInitialRowsMode = 'SHOW_INITIAL_ROWS = FALSE' %}
        {% endif %}
    {% else %}
        {% set streamInitialRowsMode = '' %}
    {% endif %}

    {# Stream Insert Only Behavior #}
    {% if streamType == 'EXTERNAL TABLE' or desiredState.config.sourceType == 'External Iceberg Table' %}      
            {% set streamInsertOnlyMode = 'INSERT_ONLY = TRUE' %}
    {% else %}
        {% set streamInsertOnlyMode = '' %}
    {% endif %}
{% endif %}

{# Create Stream first #}

{% if desiredState %}
    {%- if currentState != undefined and (currentState.node.nodeType != desiredState.node.nodeType) %}
        {%- set warningMsg = getNodeTypeSwitchWarning() | default('') %}

        {# Warning display - Node type changes can impact related tasks, streams, or services. #}
        {%- if warningMsg | trim | length > 0 -%}
            {{ stage('Warning! Node Type Switching Detected', false) }}
            {{ warningMsg }}
            select 1=0
        {%- endif -%}
    
        {%- if currentState.node.materializationType != desiredState.node.materializationType %}

            {{ stage('Drop ' + ref_no_link(currentState.node.location.name, currentState.node.name)) }}
            {%- set materialization = dropMaterialization(currentState.node.materializationType) %}
            DROP {{ materialization }} {{ ref_no_link(currentState.node.location.name, currentState.node.name) }}
        {%- endif -%}
    
    {%- endif -%}

    
    {# Create If Not Exists was removed: nodes that still have it saved are redeployed as Create or Replace #}
    {% if desiredState.config.redeploymentBehavior == 'Create If Not Exists' %}
        {% set redeploymentBehavior = 'Create or Replace' %}
        {{ stage('WARNING') }}
        /* Redeployment Behavior 'Create If Not Exists' is no longer supported. This deployment uses 'Create or Replace' instead.
           Select 'Create or Replace' or 'Create At Existing Stream' in the node's Redeployment Behavior to remove this warning. */
    {% else %}
        {% set redeploymentBehavior = desiredState.config.redeploymentBehavior %}
    {% endif %}

    {# New stream, or node type / materialization switch: there is no stream to keep, so always create it #}
    {% set isNewOrSwitch = currentState == undefined or currentState.storageLocations | length == 0
        or currentState.node.nodeType != desiredState.node.nodeType
        or currentState.node.materializationType != desiredState.node.materializationType %}
    {% set isChanged = currentState != undefined and desiredState != currentState %}

    {% if isNewOrSwitch %}
        {{ stage('Create Stream',true,"sql","create") }}
        CREATE OR REPLACE STREAM {{ ref(streamTargetLocationName, streamName) }}
            ON {{ streamType }} {{ refLink }}
            {{ streamAppendMode }}
            {{ streamInitialRowsMode }}
            {{ streamInsertOnlyMode }}

    {% else %}

        {# Location / name change: Snowflake cannot rename or move a stream, so the stream is created at its
           new location (at the previous stream's offset for Create At Existing Stream) and the previous one is dropped #}
        {% set currentDatabaseName = currentState.storageLocations | selectattr('name', 'equalto', currentState.node.location.name) | map(attribute='database') | first %}
        {% set currentSchemaName = currentState.storageLocations | selectattr('name', 'equalto', currentState.node.location.name) | map(attribute='schema') | first %}
        {% set previousStreamName = '"' + currentDatabaseName + '"."' + currentSchemaName + '"."' + currentState.node.name + '"' %}
        {% set isMoved = currentDatabaseName != streamTargetDatabaseName or currentSchemaName != streamTargetSchemaName or currentState.node.name != streamName %}

        {# Source object changed (renamed, moved, repointed or different type): AT(STREAM => ...) cannot carry an offset
           over to a different object, so the stream is created fresh #}
        {% set currentSourceNode = currentState.sources[0].dependencies[0].node %}
        {% set currentSourceDatabaseName = currentState.storageLocations | selectattr('name', 'equalto', currentSourceNode.location.name) | map(attribute='database') | first %}
        {% set currentSourceSchemaName = currentState.storageLocations | selectattr('name', 'equalto', currentSourceNode.location.name) | map(attribute='schema') | first %}
        {% set isSourceChanged = currentSourceDatabaseName != sourceDatabaseName or currentSourceSchemaName != sourceSchemaName
            or currentSourceNode.name != sourceTableName or currentState.config.sourceType != desiredState.config.sourceType %}

        {% if (isChanged and redeploymentBehavior == 'Create or Replace') or (isMoved and redeploymentBehavior != 'Create At Existing Stream') or isSourceChanged %}
            {# Also repairs a stream whose source was rebuilt, so no check is needed.
               COPY GRANTS keeps the grants of a stream replaced under the same name #}
            {{ stage('Create Stream',true,"sql","create") }}
            CREATE OR REPLACE STREAM {{ ref(streamTargetLocationName, streamName) }} COPY GRANTS
                ON {{ streamType }} {{ refLink }}
                {{ streamAppendMode }}
                {{ streamInitialRowsMode }}
                {{ streamInsertOnlyMode }}

        {% else %}

            {# Source rebuilt: a CREATE OR REPLACE / DROP+CREATE of the source leaves the stream attached to the dropped object.
               Recreate it whatever the Redeployment Behavior, since AT(STREAM => ...) cannot repair it.
               Also recreate a stale stream. Any other read error is re-raised.
               Checks the stream where it currently exists (its previous location when moved), before the stages below,
               so AT(STREAM => ...) reads a working stream.
               Always runs for this node type. #}
            {% set checkStreamName = previousStreamName if isMoved else ref_no_link(streamTargetLocationName, streamName) %}
            {{ stage('Recreate Stream If Source Was Rebuilt',true,"sql","create") }}
            EXECUTE IMMEDIATE $$
            BEGIN
                EXECUTE IMMEDIATE 'SELECT 1 FROM {{ checkStreamName }} LIMIT 0';
                RETURN 'Stream is readable: no recreate needed';
            EXCEPTION
                WHEN OTHER THEN
                    IF (CONTAINS(LOWER(SQLERRM), 'dropped, cannot read from stream') OR CONTAINS(LOWER(SQLERRM), 'stale')) THEN
                        CREATE OR REPLACE STREAM {{ checkStreamName }} COPY GRANTS
                            ON {{ streamType }} {{ refLink }}
                            {{ streamAppendMode }}
                            {{ streamInitialRowsMode }}
                            {{ streamInsertOnlyMode }};
                        RETURN 'Stream recreated: source object was rebuilt or stream was stale. Offset reset{% if streamInitialRowsMode == 'SHOW_INITIAL_ROWS = TRUE' %}, next read returns all rows in the source{% endif %}.';
                    END IF;
                    RAISE;
            END;
            $$

            {% if isMoved %}
                {# SHOW_INITIAL_ROWS is left out: it would make the stream return every row again instead of resuming at the offset #}
                {{ stage('Move Stream at existing offset',true,"sql","create") }}
                CREATE OR REPLACE STREAM {{ ref(streamTargetLocationName, streamName) }}
                    ON {{ streamType }} {{ refLink }}
                    AT(STREAM => '{{ previousStreamName }}')
                    {{ streamAppendMode }}
                    {{ streamInsertOnlyMode }}

            {% elif isChanged and redeploymentBehavior == 'Create At Existing Stream' %}
                {# SHOW_INITIAL_ROWS is left out: it would make the stream return every row again instead of resuming at the offset #}
                {{ stage('Re-Create Stream at existing offset',true,"sql","create") }}
                CREATE OR REPLACE STREAM {{ ref(streamTargetLocationName, streamName) }} COPY GRANTS
                    ON {{ streamType }} {{ refLink }}
                    AT(STREAM => '{{ ref(streamTargetLocationName, streamName) }}')
                    {{ streamAppendMode }}
                    {{ streamInsertOnlyMode }}

            {% endif %}
        {% endif %}

        {% if isMoved %}
            {{ stage('Drop Previous Stream',true,"sql","create") }}
            DROP STREAM IF EXISTS {{ previousStreamName }}
        {% endif %}
    {% endif %}

{% elif desiredState == undefined and currentState.storageLocations | length > 0 %}

    {# Source Stream Location and Name #}
    {% set streamTargetLocationName = currentState.node.location.name %}
    {% set streamTargetDatabaseName = currentState.storageLocations | selectattr('name', 'equalto', streamTargetLocationName) | map(attribute='database') | first %}
    {% set streamTargetSchemaName = currentState.storageLocations | selectattr('name', 'equalto', streamTargetLocationName) | map(attribute='schema') | first %}
    {% set streamName = currentState.node.name %}


    {{ stage('Drop ' + ref_no_link(currentState.node.location.name, currentState.node.name)) }}
    {%- set materialization = dropMaterialization(currentState.node.materializationType) %}
    DROP {{ materialization }} {{ ref_no_link(currentState.node.location.name, currentState.node.name) }}

{% endif %}
