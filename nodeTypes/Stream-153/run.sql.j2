{# == Node Type Name           : Stream == #}
{# == Node Type Description    : Recreates the stream if its source object was rebuilt (CREATE OR REPLACE / DROP+CREATE)
                                 since the stream was created, so the stream can be read again. == #}

{% if config.recreateOnSourceRebuild != false %}

    {# Stream Type #}
    {% if config.sourceType == 'External Table' %}
        {% set streamType = 'EXTERNAL TABLE' %}
    {% elif config.sourceType == 'Dynamic Table' %}
        {% set streamType = 'DYNAMIC TABLE' %}
    {% elif config.sourceType == 'View' %}
        {% set streamType = 'VIEW' %}
    {% else %}
        {% set streamType = 'TABLE' %}
    {% endif %}

    {# Stream Append / Initial Rows / Insert Only Behavior #}
    {% set streamOptions = '' %}
    {% if config.sourceType == 'Table' or config.sourceType == 'View' %}
        {% set streamOptions = streamOptions + ' APPEND_ONLY = ' + ('TRUE' if config.appendOnly == true else 'FALSE') %}
    {% endif %}
    {% if config.sourceType == 'Table' or config.sourceType == 'View' or config.sourceType == 'Dynamic Table' %}
        {% set streamOptions = streamOptions + ' SHOW_INITIAL_ROWS = ' + ('TRUE' if config.initialRows == true else 'FALSE') %}
    {% endif %}
    {% if config.sourceType == 'External Table' or config.sourceType == 'External Iceberg Table' %}
        {% set streamOptions = streamOptions + ' INSERT_ONLY = TRUE' %}
    {% endif %}

    {% set streamFqn = ref_no_link(node.location.name, node.name) %}

    {{ stage('Recreate Stream If Source Was Rebuilt') }}
    EXECUTE IMMEDIATE $$
    DECLARE
        base_object STRING;
    BEGIN
        EXECUTE IMMEDIATE 'SELECT 1 FROM {{ streamFqn }} LIMIT 0';
        RETURN 'Stream is readable: no recreate needed';
    EXCEPTION
        WHEN OTHER THEN
            IF (CONTAINS(LOWER(SQLERRM), 'dropped, cannot read from stream') OR CONTAINS(LOWER(SQLERRM), 'stale')) THEN
                {# The stream still records the source by name; that name now resolves to the rebuilt object #}
                DESCRIBE STREAM {{ streamFqn }};
                SELECT "table_name" INTO :base_object FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
                EXECUTE IMMEDIATE 'CREATE OR REPLACE STREAM {{ streamFqn }} COPY GRANTS ON {{ streamType }} ' || base_object || '{{ streamOptions }}';
                RETURN 'Stream recreated on ' || base_object || ': source object was rebuilt or stream was stale. Offset reset{% if config.initialRows == true and config.sourceType in ['Table', 'View', 'Dynamic Table'] %}, next read returns all rows in the source{% endif %}.';
            END IF;
            RAISE;
    END;
    $$

{% endif %}
